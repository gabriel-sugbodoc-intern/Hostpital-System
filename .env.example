# Application Production Environment Variables
VITE_API_URL=

# PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://user:password@localhost:5432/sugbodoc

# Stripe Credentials
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Infobip Credentials (server-side only — never exposed to the browser)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=

# HMAC secret for signing privileged session tokens
SESSION_SECRET=

# Brevo Email Credentials (server-side only — never exposed to the browser)
# Transport 1 (preferred): v3 REST API — no IP limits
BREVO_API_KEY=
# Transport 2 (fallback): SMTP relay
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# Required for both transports: sender verified in Brevo (Senders & IP page)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SugboDoc

